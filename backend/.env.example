PORT=3000
# Set this to the exact Vue origin in production, e.g. https://shop.example.com
CORS_ORIGIN=http://localhost:5173

COMAX_ENDPOINT=https://ws.comax.co.il/Comax_WebServices/CustomersOrders_Service.asmx
COMAX_SOAP_ACTION=http://ws.comax.co.il/Comax_WebServices/WriteCustomersOrderByParamsExtendedPlusPrice
COMAX_LOGIN_ID=replace_me
COMAX_LOGIN_PASSWORD=replace_me
COMAX_STORE_ID=replace_me
COMAX_PRICE_LIST_ID=replace_me

# Optional defaults. Confirm accepted values with Comax for your account.
COMAX_MODE=Add
COMAX_TIMEOUT_MS=20000
